# Cortex speech + invent (OpenAI-compatible). Required for live dialogue text.
VITE_ANIMA_LLM_BASE_URL=https://api.openai.com/v1
VITE_ANIMA_LLM_API_KEY=
VITE_ANIMA_LLM_MODEL=gpt-4o-mini

# Cognition sidecar (pnpm --filter @fluxa/cognition-sidecar start)
VITE_FLUXA_COGNITION_URL=http://127.0.0.1:8787

# Sidecar process env (not Vite): FLUXA_SELF_MODIFY=1 (default) allows Anima repo patches
# FLUXA_VAULT_ROOT FLUXA_REPO_ROOT FLUXA_PROJECTS_ROOT
