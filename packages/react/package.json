{
  "name": "@fluxa/react",
  "version": "0.1.0",
  "description": "React bindings for Fluxa — DOM/A11y + bbox sync",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react,react-dom,@fluxa/core --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --external react,react-dom,@fluxa/core --watch"
  },
  "peerDependencies": {
    "@fluxa/core": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fluxa/core": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
