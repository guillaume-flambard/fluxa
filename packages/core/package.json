{
  "name": "@fluxa/core",
  "version": "0.1.0",
  "description": "Raw WebGL2 fluid heightmap engine for Fluxa",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test:compiler": "tsx src/expression/compiler/selftest.ts",
    "test:will": "tsx src/will/selftest.ts",
    "test:memory": "tsx src/dialogue/selftest.ts",
    "test:vectors": "tsx src/cognition/vectors.selftest.ts",
    "test:sovereignty": "tsx src/sovereignty/selftest.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
